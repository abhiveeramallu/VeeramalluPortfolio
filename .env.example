# Copy to .env.local. Every variable is optional — the site works fully without any of them.

# Canonical URL used for metadata, sitemap, OG and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://abhiram.design

# AI assistant. Without a key, the chat answers from a canned FAQ grounded in data/content.ts.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Set claude-haiku-5-5 for a cheaper deployment.
CLAUDE_MODEL=

# Contact form email delivery via Resend. Without it the form offers a pre-filled mailto: instead.
RESEND_API_KEY=
# Verified sender on your Resend domain, and where messages go (defaults to the email in content.ts).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Shared rate limiting across serverless instances (otherwise in-memory per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Analytics + Speed Insights (cookieless). Set to "true" to enable.
NEXT_PUBLIC_ENABLE_ANALYTICS=
